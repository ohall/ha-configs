# Home Assistant SSH Configuration
HA_SSH_HOST=192.168.1.100
HA_SSH_PORT=22
HA_SSH_USERNAME=root
HA_SSH_PASSWORD=your-password-here
# OR use key-based authentication (recommended)
# HA_SSH_PRIVATE_KEY_PATH=/path/to/private/key

# Remote and local paths
HA_REMOTE_CONFIG_PATH=/config
HA_LOCAL_BACKUP_PATH=./backups
HA_LOCAL_CURRENT_PATH=./current

# Files to sync (comma-separated patterns)
HA_INCLUDE_PATTERNS=*.yaml,*.yml,.storage/*.json,automations/*,scripts/*,themes/*
# Files to exclude (comma-separated patterns)
HA_EXCLUDE_PATTERNS=*.log,*.db,*.db-shm,*.db-wal
